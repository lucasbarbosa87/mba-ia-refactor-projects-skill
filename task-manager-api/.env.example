# Copie para .env e ajuste os valores. Nunca versione o .env real.

# Flask / segurança
SECRET_KEY=troque-por-uma-chave-secreta-forte
FLASK_ENV=development
DEBUG=True

# Banco de dados (SQLite por padrão)
DATABASE_URI=sqlite:///tasks.db

# SMTP (notificações por e-mail) — deixe vazio para desabilitar o envio
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
