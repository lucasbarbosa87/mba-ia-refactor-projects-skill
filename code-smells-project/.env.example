# Copie para .env e ajuste os valores. Nunca versione o .env real.

# Chave usada pelo Flask (sessões/segurança). Gere um valor aleatório em produção.
SECRET_KEY=troque-por-um-valor-aleatorio

# Ativa o modo debug do Flask (nunca use "true" em produção).
DEBUG=false

# Caminho do banco SQLite.
DATABASE_PATH=loja.db

# Token exigido nos endpoints /admin/*. Sem valor, o acesso admin fica desabilitado.
ADMIN_TOKEN=

# Host/porta do servidor.
HOST=0.0.0.0
PORT=5000

# Rótulo de ambiente exibido no /health.
AMBIENTE=development
